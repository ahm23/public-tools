{
	"name": "requirements-explorer",
	"version": "0.1.0",
	"description": "Requirements/spec explorer and modification tool (Electrobun + React + Vite, plain CSS)",
	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "electrobun dev --watch",
		"dev:hmr": "concurrently \"npm run hmr\" \"npm run start\"",
		"hmr": "vite --port 5173",
		"build": "vite build && electrobun build",
		"build:canary": "vite build && electrobun build --env=canary",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"electrobun": "1.18.1",
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
